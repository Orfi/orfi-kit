{
  "version": 1,
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "matcher": "Bash",
        "bash": "bash \"@ORFI_COPILOT_HOME@/.claude/hooks/orfi-kit-enforce-sync.sh\"",
        "powershell": "& bash -c 'bash \"@ORFI_COPILOT_HOME@/.claude/hooks/orfi-kit-enforce-sync.sh\"'",
        "env": { "ORFI_HOOK_PLATFORM": "copilot" },
        "timeoutSec": 10
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "matcher": "Write|Edit|MultiEdit",
        "bash": "bash \"@ORFI_COPILOT_HOME@/.claude/hooks/orfi-kit-verify-csharp-format.sh\"",
        "powershell": "& bash -c 'bash \"@ORFI_COPILOT_HOME@/.claude/hooks/orfi-kit-verify-csharp-format.sh\"'",
        "env": { "ORFI_HOOK_PLATFORM": "copilot" },
        "timeoutSec": 120
      },
      {
        "type": "command",
        "matcher": "Write|Edit|MultiEdit",
        "bash": "bash \"@ORFI_COPILOT_HOME@/.claude/hooks/orfi-kit-verify-cpp-format.sh\"",
        "powershell": "& bash -c 'bash \"@ORFI_COPILOT_HOME@/.claude/hooks/orfi-kit-verify-cpp-format.sh\"'",
        "env": { "ORFI_HOOK_PLATFORM": "copilot" },
        "timeoutSec": 120
      }
    ],
    "Stop": [
      {
        "type": "command",
        "bash": "bash \"@ORFI_COPILOT_HOME@/.claude/hooks/orfi-kit-enforce-brevity.sh\"",
        "powershell": "& bash -c 'bash \"@ORFI_COPILOT_HOME@/.claude/hooks/orfi-kit-enforce-brevity.sh\"'",
        "env": { "ORFI_HOOK_PLATFORM": "copilot" },
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "bash \"@ORFI_COPILOT_HOME@/.claude/hooks/orfi-kit-verify-skill-contract.sh\"",
        "powershell": "& bash -c 'bash \"@ORFI_COPILOT_HOME@/.claude/hooks/orfi-kit-verify-skill-contract.sh\"'",
        "env": { "ORFI_HOOK_PLATFORM": "copilot" },
        "timeoutSec": 30
      }
    ]
  }
}